--| PySAIC's Script by brzys

local SCRIPT_VERSION = 14

-- Etc
local config = system_ini()
local lastUpdate = 0
messageLog = {}
chatBox = nil
local showChatBox = false
local ChatBoxEnabled = true
users = {}
local knownIcons = {}
local prev_money = 0
local prev_actor
local prev_level
local prev_reputation
local prev_rank
table_channel = {}
irc_name_to_description = {}
prevChannel = ''
USER_LIST_ORDER = nil
COLORED_NICKS = false
FACTION_SIZE = {}

local function gt(id)
	local result = game.translate_string(id)
	if result == id then
		return nil
	else
		return result
	end
end

local function isTrue(value)
	return value == "True"
end

-- it is reloaded every time game is loaded, should also be recreated
-- when user change language in options
local newsSoundMap = {
    [pysaic_icons.info] = "pda_welcome",
    [pysaic_icons.error] = "pda_alarm",
    ["default"] = "pda_tips"
}

local function getNewsSound(messageType)
    return newsSoundMap[messageType] or newsSoundMap["default"]
end

local function add_message_to_history(icon, title, text, reputation, rank)
	local messageLogLength = size_table(messageLog)
	if messageLogLength > pysaic_config.MAX_MESSAGE_LOG_LENGTH then
		local toRemove = messageLogLength - pysaic_config.MAX_MESSAGE_LOG_LENGTH
		for _ = toRemove, 1, -1 do
			table.remove(messageLog, 1)
		end
	end
	messageLog[#messageLog +1 ] = {
		title = title,
		text = text,
		icon = icon,
		reputation = reputation,
		rank = rank
	}
end

local function addMessage(icon, title, text, reputation, rank)
	add_message_to_history(icon, title, text, reputation, rank)
	db.actor:give_game_news(title, text, icon, 0, pysaic_config.option.newsDuration)
	if pysaic_config.option.newsSound then
		xr_sound.set_sound_play(db.actor:id(), getNewsSound(icon))
	end
	if chatBox then
		chatBox:UpdateMessages()
	end
    if crc_pda then
        crc_pda.get_ui():add_message(icon, title, text, "system")
    end
end

local function _get_title_value(faction, user_type)
    local title_value = ''
    local faction_value = ''
    if user_type == pysaic_constants.IRCUserModeEnum.Operator then
        title_value = gt("pysaic_irc_operator")
    elseif user_type == pysaic_constants.IRCUserModeEnum.HalfOp then
        title_value = gt("pysaic_irc_halfop")
    elseif user_type == pysaic_constants.IRCUserModeEnum.Voice then
        title_value = gt("pysaic_irc_voice")
    end
    if title_value ~= '' then
        title_value = title_value .. ', '
    end
    if faction then
        faction_value = gt("crc_"..faction)
    elseif gt("crc_actor_anonymous") then
        faction_value = gt("crc_actor_anonymous")
    else
        faction_value = gt("crc_unknown")
    end
    return title_value .. faction_value
end


function historyChannelHandler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	highlight = isTrue(highlight)
	local icon = handle_icon(name, faction, icon_id, user_type)
	local title = name..', '.._get_title_value(faction, user_type)
	local text = ((highlight and pysaic_config.HIGHLIGHT_COLOR) or pysaic_config.MESSAGE_COLOR) .. message
	add_message_to_history(icon, title, text, reputation, rank)
end


function historyFromPrivateHandler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	local icon = handle_icon(name, faction, icon_id, user_type)
	local title = name .. " -> " .. message_params
	local text = pysaic_config.QUERY_COLOR .. message
	add_message_to_history(icon, title, text, reputation, rank)
end

function historyToPrivateHandler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	local icon = handle_icon(name, faction, icon_id, user_type)
	local title = message_params .. " -> " .. name
	local text = pysaic_config.QUERY_COLOR .. message
	add_message_to_history(icon, title, text, reputation, rank)
end

function addInformationMessage(body)
	addMessage(
		pysaic_icons.info,
		gt("crc_info"),
		body,
		nil,
		nil
	)
end

function addErrorMessage(body)
	addMessage(
		pysaic_icons.error,
		gt("crc_error"),
		pysaic_config.ERROR_COLOR .. body,
		nil,
		nil
	)
end

function historyMoneyFromHandler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	local icon = handle_icon(name, faction, icon_id, user_type)
	local title = name .. " " .. (gt("crc_money_recv"))
	local text = pysaic_config.MONEY_COLOR .. message .. " RUB"
	add_message_to_history(icon, title, text, reputation, rank)
end

function historyMoneyToHandler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	local icon = handle_icon(name, faction, icon_id, user_type)
	local title = message_params .. " " .. (gt("crc_money")) .. " " .. name
	local text = pysaic_config.MONEY_COLOR .. message .. " RUB"
	add_message_to_history(icon, title, text, reputation, rank)
end

historyHandlers = {
	dm_from = historyFromPrivateHandler,
	dm_to = historyToPrivateHandler,
	channel = historyChannelHandler,
	info = addInformationMessage,
	error = addErrorMessage,
	money_recv = historyMoneyFromHandler,
	money_sent = historyMoneyToHandler,
}


function parseHistoryMessage(body)
	local faction, name, icon_id, reputation, rank, highlight, user_type, message_metadata, message = body:match("([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/(.+)")
	local message_type, message_params = message_metadata:match("([^,]*),(.*)")
	local handler = historyHandlers[message_type]
	if handler then
		handler(message, highlight, name, faction, icon_id, message_params, reputation, rank, user_type)
	else
		addErrorMessage("Cannot handle history type '" .. message_type .. "'")
	end
	--add_message_to_history(icon, title, text, reputation, rank)
end



function handle_icon(name, faction, icon_id, user_type)
	local icon
	if not knownIcons[name] then
		icon = pysaic_icons.getIconSafe(name, faction, icon_id, user_type)
	else
		icon = knownIcons[name]
	end
	return icon
end

function parseChannelMessage (body)
	local faction, name, icon_id, reputation, rank, highlight, user_type, message = body:match("([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/(.+)")
	highlight = isTrue(highlight)
	local icon = handle_icon(name, faction, icon_id, user_type)
	if chatBox then
		chatBox:UpdateUsers()
	end
	local text = ((highlight and pysaic_config.HIGHLIGHT_COLOR) or pysaic_config.MESSAGE_COLOR) .. message
	addMessage(
        icon,
        name..', '.._get_title_value(faction, user_type),
        text,
        reputation,
        rank
    )
    if crc_pda then
        crc_pda.get_ui():add_message(icon, name..', '.._get_title_value(faction, user_type), text, name)
    end
end

function parsePrivateMessage(body)
	local faction, user_type, from, from_icon, reputation, rank, to, message = body:match("([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/(.+)")
	local icon = handle_icon(from, faction, from_icon, user_type)
	if chatBox then
		chatBox:UpdateUsers()
	end
	addMessage(icon, from .. " -> " .. to, pysaic_config.QUERY_COLOR .. message, reputation, rank)
    if crc_pda then
        crc_pda.get_ui():add_message(icon, from .. " -> " .. to, pysaic_config.QUERY_COLOR .. message, from)
    end
end

function parseSendingMoney(body)
	local from, reputation, rank, to, amount = body:match("([^/]+)/([^/]+)/([^/]+)/([^/]+)/(.+)")
	if chatBox then
		chatBox:UpdateUsers()
	end
	local title = from .. " " .. (gt("crc_money")) .. " " .. to
	local text = pysaic_config.MONEY_COLOR .. amount .. " RUB"
	addMessage(pysaic_icons.info, title, text, reputation, rank)
	if users[from] then
		db.actor:give_money(-amount)
	end
end

function parseGettingMoney(body)
	-- parsing information fully but reputation and rank should not be displayed
	local from, reputation, rank, amount = body:match("([^/]+)/([^/]+)/([^/]+)/(.+)")
	if chatBox then
		chatBox:UpdateUsers()
	end
	local title = from .. " " .. (gt("crc_money_recv"))
	local text = pysaic_config.MONEY_COLOR .. amount .. " RUB"
	addMessage(pysaic_icons.info, title, text, reputation, rank)
	db.actor:give_money(amount)
end

function parseNewsDuration(value)
	pysaic_config.option.newsDuration = tonumber(value)
end

function parseChatKey(value)
	pysaic_config.option.chatKey = DIK_keys[value]
end

function parseNickAutoCompleteKey(value)
	pysaic_config.option.nickAutoCompleteKey = DIK_keys[value]
end

function parseNewsSound(value)
	pysaic_config.option.newsSound = isTrue(value)
end

function parseCloseChat(value)
	pysaic_config.option.closeChat = isTrue(value)
end

function parseActorStatus()
	sendActorStatus()
end

function parseCurrentChannel(value)
	prevChannel = value
end

function parseDisconnectWhenBlowoutOrUnderground(value)
	pysaic_config.option.disconnectWhenBlowoutOrUnderground = isTrue(value)
end

function parseUserDisplayStyle(value)
	if not pysaic_constants.UserDisplayStyleEnum[value] then
		value = pysaic_constants.UserDisplayStyleEnum.CRCR
	end
	pysaic_config.option.userDisplayStyle = value
end

function parseChannels(value)
	table_channel = {}
	for channel_tuple in value:gmatch("([^,]+)") do
		for irc_name, description_name in channel_tuple:gmatch("([^/]+)%s=%s([^/]+)") do
			table_channel[#table_channel+1] = irc_name
			irc_name_to_description[irc_name] = description_name
		end
	end
	if chatBox then
		chatBox:UpdateChannels()
	end
end


function parseAFK(value)
	pysaic_io.send('AFK/null')
end


function parseHandshake(body)
	pysaic_io.send_handshake(body)
end

function parseInGameDisplayOrder(value)
    if value == pysaic_constants.InGameDisplayStyleEnum.Faction then
        USER_LIST_ORDER = sort_by_faction
    elseif value == pysaic_constants.InGameDisplayStyleEnum.Faction_Counter then
        USER_LIST_ORDER = sort_by_faction_and_counter
    elseif value == pysaic_constants.InGameDisplayStyleEnum.OnlineStatus then
        USER_LIST_ORDER = sort_by_online_status
    else
        USER_LIST_ORDER = sort_by_nick
    end
    printf("User list order updated to: %s", USER_LIST_ORDER)
    if chatBox then
        chatBox:UpdateUsers()
    end
end


function parseFactionColors(value)
    COLORED_NICKS = isTrue(value)
    if chatBox then
        chatBox:UpdateUsers()
    end
end


local settingsParserMap = {
	NewsDuration = parseNewsDuration,
	ChatKey = parseChatKey,
	NickAutoCompleteKey = parseNickAutoCompleteKey,
	NewsSound = parseNewsSound,
	CloseChat = parseCloseChat,
	ActorStatus = parseActorStatus,
	CurrentChannel = parseCurrentChannel,
	DisconnectWhenBlowoutOrUnderground = parseDisconnectWhenBlowoutOrUnderground,
	UserDisplayStyle = parseUserDisplayStyle,
	Channels = parseChannels,
	AFK = parseAFK,
	Handshake = parseHandshake,
    InGameUserDisplayOrder = parseInGameDisplayOrder,
    FactionColoredNicks = parseFactionColors
}


function parseSettings(body)
	local setting, value = body:match("([^/]+)/(.+)")
	local parser = settingsParserMap[setting]
	if parser then
		parser(value)
	--else
		--printf("Unknown setting: '%s' with value: '%s'", setting, value)
	end
end

function parseUsers(body)
	users = {}
    knownIcons = {}
    FACTION_SIZE = {}
	for user_nick, faction, rank, reputation, afk, avatar_id, user_type, location in body:gmatch("([^/]+),([^/]+),([^/]+),([^/]+),([^/]+),([^/]+),([^/]+)%s=%s([^/]+)") do
		local user_icon = pysaic_icons.getIconSafe(user_nick, faction, avatar_id, user_type)
		users[user_nick] = {
			faction = faction,
			rank = rank,
			reputation = reputation,
			location = location,
			afk = afk == "1",
			icon = user_icon,
			nick = user_nick,
            user_type = user_type
		}
		knownIcons[user_nick] = user_icon
        FACTION_SIZE[faction] = (FACTION_SIZE[faction] or 0) + 1
	end
	if chatBox then
		chatBox:UpdateUsers()
	end
    if crc_pda then
        -- Adapt users table to what crc_pda expects or update crc_pda to use pysaic's users table
        -- crc_pda expects users as a table of name -> is_in_game (string "True"/"False")
        -- pysaic users is name -> table { location = "...", ... }
        local crc_users = {}
        for name, data in pairs(users) do
            crc_users[name] = (data.location ~= "False") and "True" or "False"
            -- Also need to save icon for crc_pda
            crc_pda.get_ui():save_icon(name, data.icon)
        end
        crc_pda.get_ui().users = crc_users
        if crc_pda.get_ui():is_open() then
            crc_pda.get_ui():update_users()
        end
    end
end

function parseSignalState(body)
    IS_SIGNAL_LOST = body == 'True'
end

local inputActions = {
	Information = addInformationMessage,
	Error = addErrorMessage,
	Message = parseChannelMessage,
	Query = parsePrivateMessage,
	History = parseHistoryMessage,
	Money = parseSendingMoney,
	MoneyRecv = parseGettingMoney,
	Setting = parseSettings,
	Users = parseUsers,
    SignalState = parseSignalState
}


function sendActorStatus()
	printf("Sending actor status")
    update_money(true)
	update_faction_if_not_sync(true)
	update_location_if_not_sync(true)
	update_reputation_if_not_sync(true)
	update_rank_if_not_sync(true)
	fake_conn_lost_update_client(true)
	pysaic_io.send("DEBUG/%s", DEV_DEBUG)
end

function parseInput(receiveQueue)
	for _, line in ipairs(receiveQueue) do
        if line == "" then goto continue end
		local type, body = line:match("([^/]+)/(.+)")
		if type and body then
            local action = inputActions[type]
            if action then
                --printf("Input message: %s, %s", type, body)
                action(body)
            else
                printf("No callback for '%s'", type)
                -- Whine about it
            end
        end
        ::continue::
	end
end

local function update()
    if chatBox and not chatBox.focus then
        chatBox.editBox:CaptureFocus(true)
        chatBox.focus = true
    end

    if showChatBox and ChatBoxEnabled then
        showChatBox = false
        chatBox = pysaic_chatbox.ChatBox()
        -- chatBox:UpdateChannels()
        chatBox:ShowDialog()
        -- Disable keypress callback so other scripts don't fire while typing
        Register_UI("ChatBox", "chernobyl_relay_chat")
    end

    if not db.actor or time_global() < lastUpdate + pysaic_config.UPDATE_INTERVAL then
        return
    end
    lastUpdate = time_global()

    local messages = pysaic_io.update()
    if messages then
        parseInput(messages)
    end
end

local function onDeath(whoID)
	if isDead then
		return
	end
	isDead = true
	local section, class
	local who = whoID and alife():object(whoID)
	if not who then
		section = "UNKNOWN"
		class = "UNKNOWN"
	else
		section = who:section_name()
		class = ini_sys:r_string_ex(section, "kind") or ini_sys:r_string_ex(section, "class")
		if class == "AI_STL_S" then
			class = who:community()
		end
	end
	pysaic_io.send("Death/%s/%s/%s/%s", db.actor:character_community(), level.name(), class:upper(), section)
	if chatBox then
		pysaic_chatbox.ChatBox:Cancel()
	end
	ChatBoxEnabled = false
end

local function onKeyPress(dik)
	if dik == pysaic_config.option.chatKey and not chatBox then
		if IS_SIGNAL_LOST then
			db.actor:give_game_news(gt("crc_info"), gt("crc_signallost"), pysaic_icons.info, 0, pysaic_config.option.newsDuration)
			xr_sound.set_sound_play(db.actor:id(), "pda_tips")
			pysaic_io.send("ConnLost/%s/%s", prev_fake_conn_status, get_disconnect_reason())
		else
			-- Defer to next update to avoid this keypress being sent to the UI as well
			showChatBox = true
		end
	end
end

function update_money(force_send)
    local cur_money = db.actor:money()
    if prev_money == cur_money and not force_send then
		return
	end
    prev_money = cur_money
	pysaic_io.send("Money/%s", cur_money)
end

function get_disconnect_reason()
	if (level_weathers.bLevelUnderground) then
        reason = "Underground"
    elseif (xr_conditions.surge_started()) then
        reason = "Surge"
    else
        reason = "None"
    end
	return reason
end

function fake_conn_lost_update_client(force_send)
	local cur_fake_conn_status = fake_conn_lost()
	if not force_send and prev_fake_conn_status == cur_fake_conn_status then
		return
	end
	prev_fake_conn_status = cur_fake_conn_status
    pysaic_io.send("ConnLost/%s/%s", prev_fake_conn_status, get_disconnect_reason())
    printf("Connection status updated to client - " .. tostring(cur_fake_conn_status))
end

function fake_conn_lost()
	if (level_weathers.bLevelUnderground or xr_conditions.surge_started()) then
	    if pysaic_config.option.disconnectWhenBlowoutOrUnderground then
            if IS_SIGNAL_LOST and chatBox then
                pysaic_chatbox.ChatBox:Cancel()
            end
            return true
        end
        return false
    end
	return false
end

function actor_on_update()
    update_money(nil)
	fake_conn_lost_update_client(nil)
	update_faction_if_not_sync(nil)
	update_location_if_not_sync(nil)
	update_reputation_if_not_sync(nil)
	update_rank_if_not_sync(nil)
end


function update_reputation_if_not_sync(force_send)
    if not db.actor then
        return
    end

    local current_reputation_name = utils_obj.get_reputation_name(db.actor:character_reputation())
    if prev_reputation == current_reputation_name and not force_send then
        return
    end

    pysaic_io.send("Reputation/%s", current_reputation_name)
    prev_reputation = current_reputation_name
end


function update_rank_if_not_sync(force_send)
    if not db.actor then
        return
    end

    local current_rank = ranks.get_obj_rank_name(db.actor)
    if prev_rank == current_rank and not force_send then
        return
    end

    pysaic_io.send("Rank/%s", current_rank)
    prev_rank = current_rank
end


function update_location_if_not_sync(force_send)
    local current_level = level.name()
    if prev_level == current_level and not force_send then
        return
    end
    prev_level = current_level

    pysaic_io.send("Location/%s", current_level)
end

function on_achievement_earned(param1, param2)
    pysaic_io.send("Achievement/%s/%s", param1, param2)
end

function update_faction_if_not_sync(force_send)
    if not db.actor then
        return
    end

    local current_actor = db.actor:character_community()
    if prev_actor == current_actor and not force_send then
        return
    end

    pysaic_io.send("ActorStatus/%s", current_actor)
    prev_actor = current_actor
end

function save_state(m_data)
	m_data.connstatus = prev_fake_conn_status
	m_data.prevChannel = prevChannel
end

function load_state(m_data)
    USER_LIST_ORDER = sort_by_nick
	prev_fake_conn_status = m_data.connstatus or false
	prevChannel = m_data.prevChannel or ''
end

function actor_on_net_destroy()
	if chatBox and pysaic_config.option.disconnectWhenBlowoutOrUnderground then
		pysaic_chatbox.ChatBox:Cancel()
	end
end

function actorOnItemTake(item)
	if IsArtefact(item) then
		pysaic_io.send('ArtifactFound/%s/%s/%s', item:name(), level.name(), item:section())
	end
end

function start_pysaic()
    pysaic_io.init()
    pysaic_io.send_handshake('startup')
end

function sort_by_nick(nick, other_nick)
	return nick:lower() < other_nick:lower()
end

function sort_by_online_status(nick, other_nick)
    local user = users[nick]
    local other_user = users[other_nick]
    if user.location == "False" and other_user.location ~= "False" then
        return false
    elseif user.location ~= "False" and other_user.location == "False" then
        return true
    else
        return sort_by_nick(nick, other_nick)
    end
end

function sort_by_faction(nick, other_nick)
    local user = users[nick]
    local other_user = users[other_nick]
    local anonymous_faction = "actor_anonymous"
    local size_user = FACTION_SIZE[user.faction] or 0
    local size_other = FACTION_SIZE[other_user.faction] or 0
    if size_user ~= size_other then
        return size_user > size_other
    end
    if user.faction ~= other_user.faction then
        if user.faction == anonymous_faction then
            return false
        end
        if other_user.faction == anonymous_faction then
            return true
        end
        return gt('crc_' .. user.faction) < gt('crc_' .. other_user.faction)
    end
    return sort_by_online_status(nick, other_nick)
end

function sort_by_faction_and_counter(nick, other_nick)
    return sort_by_faction(nick, other_nick)
end

function pairsByKeys(t, f)
	local a = {}
	for n in pairs(t) do
		a[#a+1] = n
	end
	table.sort(a, f)
	local i = 0
	return function() -- iterator
		i = i + 1
		return a[i], t[a[i]]
	end
end

function on_game_start()
    printf('PySAIC script started with version %s', SCRIPT_VERSION)
	isDead = false
	ChatBoxEnabled = true
    USER_LIST_ORDER = sort_by_nick
	AddUniqueCall(update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("actor_on_before_death", onDeath)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_achievement_earned", on_achievement_earned)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	-- Not using axr_keybind for old version compatibility
	RegisterScriptCallback("on_key_press", onKeyPress)
	RegisterScriptCallback("actor_on_item_take", actorOnItemTake)
    RegisterScriptCallback("actor_on_first_update", start_pysaic)
end
