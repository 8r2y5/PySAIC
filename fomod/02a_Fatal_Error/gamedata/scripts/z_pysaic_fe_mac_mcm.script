function on_game_start()
    if crc_pda then
        local function pysaic_ui_start()
            local pysaic_ui = crc_pda.get_ui()
            if pysaic_ui then
                pysaic_ui:update_ui()
            end
            return pysaic_ui
        end
        mac_mcm.add_app("app_pysaic", {name = "pda_btn_pysaic", texture = "app_pysaic", tab = "eptChat", func = pysaic_ui_start})
    end
end